            pretrained_emb = self.pretrained_embedding(x)
            x = torch.cat([trainable_emb, pretrained_emb], dim=-1)
        else:
            x = trainable_emb

        x, _ = self.bigru(x)
        x = x.permute(0, 2, 1)  # For pooling
        x = self.global_max_pool(x).squeeze(-1)
        x = self.dropout(x)
        x = self.fc(x)
        return x
    
